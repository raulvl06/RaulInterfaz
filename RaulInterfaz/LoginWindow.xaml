<Window x:Class="MiProyecto.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAMESTATION — Iniciar sesión"
        Width="480"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#080c14">

    <Border Background="#101722"
            CornerRadius="16"
            BorderBrush="#1e293b"
            BorderThickness="1">

        <Grid Margin="45">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                <TextBlock Text="GAMESTATION"
                           FontSize="30"
                           FontWeight="Black"
                           Foreground="#38bdf8"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Inicia sesión para acceder a tu ecosistema"
                           FontSize="12"
                           Foreground="#64748b"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- FORMULARIO -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">

                <!-- USUARIO -->
                <TextBlock Text="NOMBRE DE CUENTA"
                           Foreground="#94a3b8"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <Border Background="#182232"
                        CornerRadius="8"
                        BorderBrush="#293548"
                        BorderThickness="1"
                        Height="44"
                        Margin="0,0,0,16">
                    <TextBox x:Name="txtUsuario"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="14,0"
                             FontSize="14"/>
                </Border>

                <!-- CONTRASEÑA -->
                <TextBlock Text="CONTRASEÑA"
                           Foreground="#94a3b8"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <Border Background="#182232"
                        CornerRadius="8"
                        BorderBrush="#293548"
                        BorderThickness="1"
                        Height="44"
                        Margin="0,0,0,16">
                    <PasswordBox x:Name="txtPassword"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="14,0"
                                 FontSize="14"/>
                </Border>

                <!-- MENSAJE DE ERROR -->
                <Border x:Name="BorderError"
                        Background="#2a1215"
                        BorderBrush="#5c1d24"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txtError"
                               Text=""
                               Foreground="#f87171"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- BOTÓN INICIAR SESIÓN -->
                <Button Content="INICIAR SESIÓN"
                        Height="46"
                        Click="Login_Click"
                        Background="#0ea5e9"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="13"
                        Margin="0,0,0,10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- BOTÓN SALIR -->
                <Button Content="Salir de la aplicación"
                        Height="40"
                        Click="Salir_Click"
                        Background="#182232"
                        Foreground="#94a3b8"
                        BorderBrush="#293548"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>