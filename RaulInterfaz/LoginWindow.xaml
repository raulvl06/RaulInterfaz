<Window x:Class="MiProyecto.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStation — Autenticación"
        Width="440"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgRoot}">

    <Border Background="{StaticResource BgPanel}"
            CornerRadius="12"
            BorderBrush="{StaticResource BorderDark}"
            BorderThickness="1"
            Margin="24">

        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- LOGO / MARCA -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock Text="GAMESTATION"
                           FontSize="24"
                           FontWeight="Black"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- CAMPOS Y ACCESOS -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">

                <TextBlock Text="NOMBRE DE USUARIO" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="{StaticResource BgCard}" CornerRadius="6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Height="40" Margin="0,0,0,16">
                    <TextBox x:Name="txtUsuario" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" FontSize="13"/>
                </Border>

                <TextBlock Text="CONTRASEÑA" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="{StaticResource BgCard}" CornerRadius="6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Height="40" Margin="0,0,0,16">
                    <PasswordBox x:Name="txtPassword" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" VerticalContentAlignment="Center" Padding="12,0" FontSize="13"/>
                </Border>

                <!-- ERROR DINÁMICO -->
                <Border x:Name="BorderError" Background="#221013" BorderBrush="#521c24" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="txtError" Text="" Foreground="{StaticResource ErrorRed}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>

                <!-- BOTONES -->
                <Button Content="INICIAR SESIÓN" Height="42" Click="Login_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>

                <Button Content="Salir" Height="36" Click="Salir_Click" Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Center"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>