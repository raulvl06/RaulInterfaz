<Window x:Class="MiProyecto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameStation"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#080c14">

    <Grid Margin="12">

        <Border Background="#101722"
                CornerRadius="14"
                BorderBrush="#1e293b"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BARRA SUPERIOR -->
                <Border Grid.Row="0"
                        Background="#080c14"
                        CornerRadius="14,14,0,0">

                    <Grid>
                        <TextBlock Text="GAMESTATION"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="#38bdf8"
                                   VerticalAlignment="Center"
                                   Margin="30,0,0,0"/>

                        <!-- MENÚ CENTRAL -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Button Content="TIENDA" Click="Tienda_Click" Margin="6" Padding="18,9" Background="#182232" Foreground="#cbd5e1" BorderBrush="#293548" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="BIBLIOTECA" Click="Biblioteca_Click" Margin="6" Padding="18,9" Background="#182232" Foreground="#cbd5e1" BorderBrush="#293548" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="COMUNIDAD" Click="Comunidad_Click" Margin="6" Padding="18,9" Background="#182232" Foreground="#cbd5e1" BorderBrush="#293548" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="SOPORTE" Click="Soporte_Click" Margin="6" Padding="18,9" Background="#182232" Foreground="#cbd5e1" BorderBrush="#293548" BorderThickness="1" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                        </StackPanel>

                        <!-- BOTÓN PERFIL -->
                        <Button x:Name="BtnPerfil"
                                Content="Usuario"
                                Grid.Row="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,25,0"
                                Padding="16,9"
                                Click="Perfil_Click"
                                Background="#182232"
                                Foreground="White"
                                BorderBrush="#293548"
                                BorderThickness="1"
                                FontWeight="Bold"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- CONTENEDOR DE SECCIONES -->
                <Border Grid.Row="1"
                        Margin="20"
                        Background="#101722"
                        CornerRadius="10">

                    <Grid x:Name="Contenido">

                        <!-- ========================================= -->
                        <!-- 1. BIBLIOTECA                             -->
                        <!-- ========================================= -->
                        <Grid x:Name="Biblioteca" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- MENÚ LATERAL BIBLIOTECA -->
                            <Border Grid.Column="0" Background="#080c14" CornerRadius="10,0,0,10">
                                <StackPanel Margin="10">
                                    <TextBlock Text="TUS JUEGOS" FontSize="15" FontWeight="Bold" Foreground="#64748b" Margin="15,20,15,12"/>

                                    <Button Content="Minecraft" Margin="5,4" Height="42" Click="Juego1_Click" Background="#182232" Foreground="#e2e8f0" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="15,0" FontWeight="SemiBold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="FC 27" Margin="5,4" Height="42" Click="Juego2_Click" Background="#182232" Foreground="#e2e8f0" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="15,0" FontWeight="SemiBold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="Overwatch" Margin="5,4" Height="42" Click="Juego3_Click" Background="#182232" Foreground="#e2e8f0" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="15,0" FontWeight="SemiBold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- CONTENIDO PRINCIPAL BIBLIOTECA (GRID DE JUEGOS) -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20">
                                    <TextBlock Text="Biblioteca" FontSize="28" FontWeight="Bold" Foreground="White" Margin="10,10,10,2"/>
                                    <TextBlock Text="Selecciona un título para iniciar tu sesión de juego" FontSize="13" Foreground="#64748b" Margin="10,0,10,20"/>

                                    <WrapPanel Margin="5">
                                        <!-- MINECRAFT CARD -->
                                        <Border Width="210" Height="280" Margin="10" CornerRadius="10" Background="#182232" BorderBrush="#293548" BorderThickness="1">
                                            <Grid>
                                                <Image Source="/Imagenes/Minecraft.png" Stretch="UniformToFill"/>
                                                <Border Background="#80000000" CornerRadius="10"/>
                                                <StackPanel VerticalAlignment="Bottom" Margin="18">
                                                    <TextBlock Text="Minecraft" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="Listo para jugar" FontSize="12" Foreground="#38bdf8" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- FC 27 CARD -->
                                        <Border Width="210" Height="280" Margin="10" CornerRadius="10" Background="#182232" BorderBrush="#293548" BorderThickness="1">
                                            <Grid>
                                                <Image Source="/Imagenes/FC27.png" Stretch="UniformToFill"/>
                                                <Border Background="#80000000" CornerRadius="10"/>
                                                <StackPanel VerticalAlignment="Bottom" Margin="18">
                                                    <TextBlock Text="FC 27" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="Listo para jugar" FontSize="12" Foreground="#38bdf8" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- OVERWATCH CARD -->
                                        <Border Width="210" Height="280" Margin="10" CornerRadius="10" Background="#182232" BorderBrush="#293548" BorderThickness="1">
                                            <Grid>
                                                <Image Source="/Imagenes/Overwatch.png" Stretch="UniformToFill"/>
                                                <Border Background="#80000000" CornerRadius="10"/>
                                                <StackPanel VerticalAlignment="Bottom" Margin="18">
                                                    <TextBlock Text="Overwatch" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                                    <TextBlock Text="Listo para jugar" FontSize="12" Foreground="#38bdf8" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ========================================= -->
                        <!-- 2. TIENDA                                 -->
                        <!-- ========================================= -->
                        <StackPanel x:Name="Tienda" Visibility="Collapsed" Margin="30">
                            <TextBlock Text="Tienda de Juegos" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,10,0,2"/>
                            <TextBlock Text="Explora lanzamientos y adquiere nuevos contenidos" FontSize="13" Foreground="#64748b" Margin="0,0,0,25"/>

                            <Button Content="Diablo IV                 —                 60 €" Width="380" Height="52" HorizontalAlignment="Left" Margin="0,8" Click="ComprarDiablo_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="15" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="20,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Fortnite                  —                 GRATIS" Width="380" Height="52" HorizontalAlignment="Left" Margin="0,8" Click="ComprarFortnite_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="15" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="20,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Call of Duty          —                 70 €" Width="380" Height="52" HorizontalAlignment="Left" Margin="0,8" Click="ComprarCallOfDuty_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="15" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="20,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- ========================================= -->
                        <!-- 3. COMUNIDAD                              -->
                        <!-- ========================================= -->
                        <StackPanel x:Name="Comunidad" Visibility="Collapsed" Margin="30">
                            <TextBlock Text="Comunidad Global" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,10,0,2"/>
                            <TextBlock Text="Interactúa, debate y encuentra compañeros de partida" FontSize="13" Foreground="#64748b" Margin="0,0,0,25"/>

                            <Button Content="Foros de Discusión" Width="260" Height="48" HorizontalAlignment="Left" Margin="0,8" Click="Foro_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="18,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Lista de Amigos" Width="260" Height="48" HorizontalAlignment="Left" Margin="0,8" Click="Amigos_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="18,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- ========================================= -->
                        <!-- 4. SOPORTE                                -->
                        <!-- ========================================= -->
                        <StackPanel x:Name="Soporte" Visibility="Collapsed" Margin="30">
                            <TextBlock Text="Centro de Soporte" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,10,0,2"/>
                            <TextBlock Text="Resolución de incidencias y asistencia técnica" FontSize="13" Foreground="#64748b" Margin="0,0,0,25"/>

                            <Button Content="Centro de Ayuda" Width="260" Height="48" HorizontalAlignment="Left" Margin="0,8" Click="Ayuda_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="18,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Contactar con Soporte" Width="260" Height="48" HorizontalAlignment="Left" Margin="0,8" Click="Contactar_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="18,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <!-- ========================================= -->
                        <!-- 5. PERFIL                                 -->
                        <!-- ========================================= -->
                        <StackPanel x:Name="Perfil" Visibility="Collapsed" Margin="30">
                            <TextBlock Text="Configuración de Cuenta" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,10,0,2"/>
                            <TextBlock Text="Gestiona tus credenciales y preferencias personales" FontSize="13" Foreground="#64748b" Margin="0,0,0,25"/>

                            <Button Content="Detalles de mi cuenta" Width="260" Height="48" HorizontalAlignment="Left" Margin="0,8" Click="MiCuenta_Click" Background="#182232" Foreground="White" BorderBrush="#293548" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="18,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Cerrar sesión" Width="260" Height="48" HorizontalAlignment="Left" Margin="0,8" Click="CerrarSesion_Click" Background="#2a1215" Foreground="#f87171" BorderBrush="#5c1d24" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="18,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Salir de la aplicación" Width="260" Height="48" HorizontalAlignment="Left" Margin="0,8" Click="Salir_Click" Background="#2a1215" Foreground="#f87171" BorderBrush="#5c1d24" BorderThickness="1" FontSize="14" FontWeight="SemiBold" Cursor="Hand" HorizontalContentAlignment="Left" Padding="18,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>